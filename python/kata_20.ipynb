   "source": [
    "#Para una lista con elementos de tipo integer y string, obtén una nueva lista solo con los valores int. Usa la función filter().\n",
    "elementos = [1, \"dos\", 3, \"cuatro\", 5, \"seis\", 7]\n",
    "\n",
    "solo_enteros = list(filter(lambda elemento: type(elemento) == int, elementos))\n",
    "\n",
    "print(solo_enteros)"
   ]
  }
