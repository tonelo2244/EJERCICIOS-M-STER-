   "source": [
    "#Crea una función lambda que sume 3 a cada número de una lista dada.\n",
    "\n",
    "numeros = [1, 5, 10, 15, 20]\n",
    "\n",
    "numeros_mas_tres = list(map(lambda numero: numero + 3, numeros))\n",
    "\n",
    "print(numeros_mas_tres)"
   ]
