   "source": [
    "#Escribe una función que calcule el factorial de un número de manera recursiva.\n",
    "def factorial(numero):\n",
    "    if numero == 0 or numero == 1:\n",
    "        return 1\n",
    "\n",
    "    return numero * factorial(numero - 1)\n",
    "\n",
    "\n",
    "numero = 5\n",
    "\n",
    "print(factorial(numero))"
   ]
  }
