   "source": [
    "#Crea una función que calcule el promedio de una lista de números.\n",
    "def calcular_promedio(numeros):\n",
    "    return sum(numeros) / len(numeros)\n",
    "\n",
    "\n",
    "numeros = [4, 8, 15, 16, 23, 42]\n",
    "print(calcular_promedio(numeros))"
   ]
