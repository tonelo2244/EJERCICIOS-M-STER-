   "source": [
    "#Concatena una lista de palabras. Usa la función reduce().\n",
    "from functools import reduce\n",
    "\n",
    "palabras = [\"Me\", \"encanta\", \"programar\", \"en\", \"Python\"]\n",
    "\n",
    "frase = reduce(lambda acumulado, palabra: acumulado + \" \" + palabra, palabras)\n",
    "\n",
    "print(frase)"
   ]
  }
