   "source": [
    "#Calcula la diferencia total en los valores de una lista. Usa la función reduce().\n",
    "from functools import reduce\n",
    "\n",
    "numeros = [100, 20, 15, 5]\n",
    "\n",
    "diferencia_total = reduce(lambda acumulado, numero: acumulado - numero, numeros)\n",
    "\n",
    "print(diferencia_total)"
   ]
  }
